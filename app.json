{
  "expo": {
    "name": "YUXA Sayi Siralama",
    "slug": "ordix",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-yuxa.png",
    "scheme": "yuxa",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "description": "Eğlenceli sayı sıralama oyunu! Sayıları küçükten büyüğe doğru sırala ve en yüksek skoru elde et. Zihin egzersizi için mükemmel!",
    "primaryColor": "#FF7A33",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yuxa.sayisiralama",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Bu uygulama kamera kullanmaz",
        "NSMicrophoneUsageDescription": "Bu uygulama mikrofon kullanmaz"
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo-yuxa.png",
        "backgroundColor": "#FF7A33"
      },
      "package": "com.yuxa.sayisiralama",
      "versionCode": 1,
      "permissions": [
        "VIBRATE",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "blockedPermissions": [
        "RECORD_AUDIO"
      ],
      "playStoreUrl": "https://play.google.com/store/apps/details?id=com.yuxa.sayisiralama"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/logo-yuxa.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-av",
        {
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo-yuxa.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FF7A33"
        }
      ],
      "expo-web-browser",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d3d3d717-b2a1-41b5-8b05-3fdd11c4383c"
      }
    },
    "owner": "sundevflower"
  }
}
